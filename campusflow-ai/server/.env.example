# 选择 openai、grok 或 gemini。API 密钥仅保存在服务端，切勿放进手机 App。
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-3.8-flash
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
PORT=8787

# 可选的服务商配置：
# OpenAI: AI_PROVIDER=openai, AI_MODEL=gpt-4o-mini, AI_BASE_URL=https://api.openai.com
# Grok: AI_PROVIDER=grok, AI_MODEL=grok-4.7, AI_BASE_URL=https://api.x.ai
# Gemini 免费层: AI_PROVIDER=gemini, AI_MODEL=gemini-3.8-flash
# Gemini 密钥从 Google AI Studio 获取；免费层限额与数据政策以 Google 当前说明为准。

# 也兼容旧的 OPENAI_API_KEY / OPENAI_MODEL / OPENAI_BASE_URL 配置。
# 面向真机或共享 APK 时，请将此服务部署为受控的 HTTPS 服务。
