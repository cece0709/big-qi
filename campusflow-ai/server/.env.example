# 选择 openai 或 grok。API 密钥仅保存在服务端，切勿放进手机 App。
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com
PORT=8787

# 使用 Grok 时改为以下配置，并在 AI_API_KEY 中放 xAI API key：
# AI_PROVIDER=grok
# AI_API_KEY=
# AI_MODEL=grok-4.7
# AI_BASE_URL=https://api.x.ai

# 也兼容旧的 OPENAI_API_KEY / OPENAI_MODEL / OPENAI_BASE_URL 配置。
# 面向真机或共享 APK 时，请将此服务部署为受控的 HTTPS 服务。
