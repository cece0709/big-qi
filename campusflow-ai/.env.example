# Public value bundled in the app. Never put API keys in EXPO_PUBLIC_* variables.
# Browser: localhost. Android phone: replace with your computer's LAN IPv4 address.
# Android emulator: normally http://10.0.2.2:8787. Shared APK: use an HTTPS proxy URL.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8787

# Server-only credentials belong in server/.env, copied from server/.env.example.
