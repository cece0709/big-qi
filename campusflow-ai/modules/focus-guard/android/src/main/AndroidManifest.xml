<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Android only grants this after the owner enables Usage Access in Settings. -->
  <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />

  <!-- Keep package visibility limited to apps that expose a normal launcher entry. -->
  <queries>
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.LAUNCHER" />
    </intent>
  </queries>

  <application>
    <service
      android:name="expo.modules.focusguard.FocusGuardAccessibilityService"
      android:exported="true"
      android:label="@string/focus_guard_service_label"
      android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
      <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
      </intent-filter>
      <meta-data
        android:name="android.accessibilityservice"
        android:resource="@xml/focus_guard_accessibility_service" />
    </service>
  </application>
</manifest>
